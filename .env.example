# ============================================
# INVOICE & RECEIPT DATA EXTRACTOR - CONFIG
# ============================================

# Server
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Modalità di lancio:
#   waitlist (default) -> pre-lancio, senza Partita IVA attiva. I pulsanti
#     dei piani a pagamento raccolgono l'interesse (email) in /api/waitlist/join
#     invece di avviare un vero checkout Stripe. Nessun pagamento reale viene
#     mai processato in questa modalità (il checkout è anche bloccato lato
#     server, vedi src/routes/stripe.js).
#   live -> comportamento normale: checkout Stripe reale sui piani a pagamento.
# Il piano Free non è mai interessato da questo interruttore.
LAUNCH_MODE=waitlist

# Anthropic API (Claude)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLAUDE_MODEL=claude-sonnet-5

# Upload limits
MAX_FILE_SIZE_MB=10
MAX_FILES_PER_REQUEST=10
# Beta default: reject larger documents before provider calls or quota reservation.
MAX_PAGES_PER_FILE=20
ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png,image/webp

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Piani (limiti espressi in PAGINE al mese, non in numero di file)
FREE_PLAN_MONTHLY_SCANS=5
STARTER_PLAN_MONTHLY_SCANS=30
BUSINESS_PLAN_MONTHLY_SCANS=150
GROWTH_PLAN_MONTHLY_SCANS=500
STUDIO_PLAN_MONTHLY_SCANS=2000

# Stripe
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
STARTER_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
BUSINESS_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROWTH_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
STUDIO_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_SUCCESS_URL=http://localhost:3000/?checkout=success
STRIPE_CANCEL_URL=http://localhost:3000/?checkout=cancel

# Autenticazione (Magic Link via email + firma sessione JWT)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=onboarding@resend.dev
SESSION_SECRET=replace-with-a-secure-random-secret

# TEST_MODE: Beta testing with daily per-user extraction quota
# When TEST_MODE=true: authenticated users get daily quota (TEST_DAILY_EXTRACTION_LIMIT pages/day)
# When TEST_MODE=false (default): normal monthly paid-plan enforcement
# Only exact lowercase true/false are accepted; other configured values fail startup.
TEST_MODE=false
TEST_DAILY_EXTRACTION_LIMIT=50

# Proxy fidati (hop) davanti a Express. Default 1 = Render (un solo load balancer).
# Usa 0 se il server e' esposto direttamente (nessun proxy). Mai "true".
TRUST_PROXY_HOPS=1
