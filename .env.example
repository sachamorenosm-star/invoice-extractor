# ============================================
# INVOICE & RECEIPT DATA EXTRACTOR - CONFIG
# ============================================

# Server
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Anthropic API (Claude)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLAUDE_MODEL=claude-sonnet-5

# Upload limits
MAX_FILE_SIZE_MB=10
MAX_FILES_PER_REQUEST=10
ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png,image/webp

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Piani (limiti espressi in PAGINE al mese, non in numero di file)
FREE_PLAN_MONTHLY_SCANS=5
STARTER_PLAN_MONTHLY_SCANS=30
BUSINESS_PLAN_MONTHLY_SCANS=150
GROWTH_PLAN_MONTHLY_SCANS=500
STUDIO_PLAN_MONTHLY_SCANS=2000

# Stripe
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
STARTER_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
BUSINESS_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROWTH_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
STUDIO_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_SUCCESS_URL=http://localhost:3000/?checkout=success
STRIPE_CANCEL_URL=http://localhost:3000/?checkout=cancel

# Session / Auth (minimale, per demo dei limiti di scansione)
SESSION_SECRET=change-this-to-a-long-random-string
